#!/bin/bash
# .git/hooks/commit-msg

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Ignore merge commits
if echo "$commit_msg" | grep -q "^Merge branch"; then
    exit 0
fi

# Regex pattern for Semantic Commit Format
pattern="^(feat|fix|docs|style|refactor|test|chore)(\([a-zA-Z0-9_-]+\))?: .+"

if ! echo "$commit_msg" | head -n1 | grep -Eq "$pattern"; then
    echo "ERROR: Commit message does not match Semantic Commit format"
    echo ""
    echo "Expected format: <type>(<scope>): <subject>"
    echo "Types: feat, fix, docs, style, refactor, test, chore"
    echo ""
    echo "Example:"
    echo "  feat: add hat wobble"
    echo "  fix(auth): resolve login timeout"
    exit 1
fi